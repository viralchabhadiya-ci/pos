DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_dev
PORT=3000
PUBLIC_URL=http://localhost:3000
# How long the card terminal simulator waits before answering, in milliseconds.
CARD_SIMULATOR_DELAY_MS=3000
# Set to 1 when the API runs behind a load balancer or reverse proxy, so sign-up limits see the real client address.
TRUST_PROXY=0
