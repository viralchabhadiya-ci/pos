# The cloud API the hub forwards to.
CLOUD_URL=http://localhost:3000
PORT=4100
# SQLite file and queue live here. It holds device tokens: keep it on the store PC only.
DATA_DIR=./data
# Receipt printer on the LAN (raw TCP / JetDirect). Leave empty if there is none.
PRINTER_HOST=
PRINTER_PORT=9100
# 48 characters for 80 mm paper, 32 for 58 mm.
PRINTER_WIDTH=48
